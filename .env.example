# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret (NEVER exposed to the browser, do not prefix with NEXT_PUBLIC_).
# Needed for admin user management (create users, reset passwords, deactivate).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: hidden email domain used to map usernames to Supabase auth emails.
# Sign-in stays username + password; this domain is never shown to users.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=assets.local

# Optional: public Storage bucket for photos (defaults to tree-photos).
# Inspectors upload <username>/<marker seq>_<epoch ms>.webp; the record stores the
# public URL, e.g.
# https://<project>.supabase.co/storage/v1/object/public/tree-photos/sitechecker1/3_1783477395101.webp
NEXT_PUBLIC_PHOTO_BUCKET=tree-photos
