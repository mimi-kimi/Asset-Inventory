# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret (NEVER exposed to the browser, do not prefix with NEXT_PUBLIC_).
# Needed for admin user management (create users, reset passwords, deactivate).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: hidden email domain used to map usernames to Supabase auth emails.
# Sign-in stays username + password; this domain is never shown to users.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=assets.local
